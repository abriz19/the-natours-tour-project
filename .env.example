NODE_ENV=development
PORT=4444

# MongoDB connection string. <PASSWORD> is replaced with PASSWORD below.
DATABASE=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/Natours?retryWrites=true&w=majority
PASSWORD=your-database-password

# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30

# SMTP settings for password-reset emails (e.g. a Mailtrap sandbox inbox)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=Natours <hello@natours.io>
