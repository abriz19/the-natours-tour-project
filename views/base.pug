doctype html
include _mixins
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title= title ? `${title} | Natours` : 'Natours'
    link(rel='icon' type='image/svg+xml' href='/img/logo.svg')
    link(rel='stylesheet' href='/css/style.css')
  body
    include _header
    #alerts.alerts(aria-live='polite')
    main.main
      block content
    include _footer
    script(src='/js/main.js' defer)
