doctype html
include _mixins
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title= title ? `${title} | Natours` : 'Natours'
    link(rel='icon' type='image/svg+xml' href='/img/logo.svg')
    link(rel='stylesheet' href='/css/style.css')
  body
    include _header
    if user && user.demo
      .demo-banner(role='note')
        if user.role === 'user'
          | You're using the public demo customer account. You can write and edit reviews, but profile and password changes are turned off.
        else
          | You're using the read-only demo admin account. You can open every page and form, but saving and deleting are turned off.
    #alerts.alerts(aria-live='polite')
    main.main
      block content
    include _footer
    script(src='/js/main.js' defer)
