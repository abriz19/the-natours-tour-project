extends base

block content
  .auth
    .auth__card
      h1.auth__title Forgot your password?
      p.muted Enter your email and we'll send you a link to choose a new one. The link is valid for 10 minutes.
      form.form#forgot-form
        .field
          label.field__label(for='email') Email
          input.field__input#email(type='email' name='email' required autocomplete='email')
        button.btn.btn--block(type='submit') Send reset link
      .auth__links
        a(href='/login') Back to log in
