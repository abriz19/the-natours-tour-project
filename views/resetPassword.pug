extends base

block content
  .auth
    .auth__card
      h1.auth__title Choose a new password
      p.muted After saving you'll be logged in automatically.
      form.form#reset-form(data-token=token)
        .field
          label.field__label(for='password') New password
          input.field__input#password(type='password' name='password' required minlength='8' autocomplete='new-password')
          span.field__hint At least 8 characters.
        .field
          label.field__label(for='passwordConfirmation') Confirm new password
          input.field__input#passwordConfirmation(type='password' name='passwordConfirmation' required minlength='8' autocomplete='new-password')
        button.btn.btn--block(type='submit') Save new password
      .auth__links
        a(href='/forgot-password') Request a new link
