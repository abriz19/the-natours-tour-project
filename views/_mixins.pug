//- Inline SVG icons (stroke style)
mixin icon(name)
  svg.icon(viewBox='0 0 24 24' aria-hidden='true' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
    case name
      when 'pin'
        path(d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z')
        circle(cx='12' cy='10' r='3')
      when 'calendar'
        rect(x='3' y='4' width='18' height='18' rx='2')
        line(x1='16' y1='2' x2='16' y2='6')
        line(x1='8' y1='2' x2='8' y2='6')
        line(x1='3' y1='10' x2='21' y2='10')
      when 'clock'
        circle(cx='12' cy='12' r='10')
        polyline(points='12 6 12 12 16 14')
      when 'users'
        path(d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2')
        circle(cx='9' cy='7' r='4')
        path(d='M23 21v-2a4 4 0 0 0-3-3.87')
        path(d='M16 3.13a4 4 0 0 1 0 7.75')
      when 'trend'
        polyline(points='23 6 13.5 15.5 8.5 10.5 1 18')
        polyline(points='17 6 23 6 23 12')
      when 'search'
        circle(cx='11' cy='11' r='8')
        line(x1='21' y1='21' x2='16.65' y2='16.65')
      when 'tag'
        path(d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z')
        line(x1='7' y1='7' x2='7.01' y2='7')
      when 'compass'
        circle(cx='12' cy='12' r='10')
        polygon(points='16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76')

//- Read-only star rating
mixin stars(rating)
  - const rounded = Math.round(rating || 0)
  span.stars(role='img' aria-label=`${rating || 0} out of 5 stars`)
    each n in [1, 2, 3, 4, 5]
      svg.star(class=n <= rounded ? 'star--on' : '' viewBox='0 0 24 24' aria-hidden='true')
        polygon(points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2')

//- Clickable 1-5 star input (radio buttons)
mixin ratingInput(id, value)
  fieldset.rating-input
    legend.field__label Rating
    .rating-input__stars
      each n in [5, 4, 3, 2, 1]
        input(type='radio' id=`${id}-${n}` name='rating' value=n checked=value === n required)
        label(for=`${id}-${n}` title=`${n} star${n > 1 ? 's' : ''}`)
          span.sr-only #{n} star#{n > 1 ? 's' : ''}
          svg(viewBox='0 0 24 24' aria-hidden='true')
            polygon(points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2')

//- Tour cover: colour gradient with the image on top (hidden by JS if it fails to load)
mixin cover(tour, className)
  div(class=className style=h.coverStyle(tour.name))
    if h.imageSrc(tour.imageCover)
      img.cover-img(src=h.imageSrc(tour.imageCover) alt='' loading='lazy')

mixin tourCard(tour)
  - const next = h.nextStartDate(tour.startDate)
  article.card
    a.card__media(href=h.tourUrl(tour) tabindex='-1' aria-hidden='true')
      +cover(tour, 'card__cover')
      if tour.difficulty
        span.badge(class=`badge--${tour.difficulty}`)= tour.difficulty
    .card__body
      h3.card__title
        a(href=h.tourUrl(tour))= tour.name
      p.card__summary= tour.summary
      ul.facts
        li
          +icon('clock')
          | #{tour.duration}-day tour
        li
          +icon('users')
          | #{tour.maxGroupSize ? `Up to ${tour.maxGroupSize} people` : 'Any group size'}
        li
          +icon('calendar')
          | #{next ? h.formatDate(next, { month: 'short', year: 'numeric' }) : 'Dates TBA'}
        li
          +icon('pin')
          | #{tour.startLocation && tour.startLocation.address ? tour.startLocation.address : 'Location TBA'}
    .card__footer
      div
        span.price= h.money(tour.price)
        span.muted  per person
      span.rating
        +stars(tour.ratingsAverage)
        span.muted #{tour.ratingsAverage} (#{tour.ratingsQuantity})

//- One review. opts.tour shows which tour the review belongs to.
mixin reviewItem(review, opts)
  - const owner = review.user
  - const isMine = Boolean(user && owner && String(owner._id) === String(user._id))
  - const canEdit = Boolean(user && (isMine || user.role === 'admin'))
  - const canDelete = Boolean(user && (isMine || ['admin', 'lead-guide'].includes(user.role)))
  li.review(data-review=review.id)
    .review__head
      span.avatar= h.initial(owner ? owner.name : '?')
      .review__who
        strong= owner ? owner.name : 'Deleted user'
        if isMine
          span.badge.badge--you You
        span.muted.review__date
          if opts && opts.tour !== undefined
            if opts.tour
              a(href=h.tourUrl(opts.tour))= opts.tour.name
            else
              | Tour no longer available
            |  &middot;
          = h.formatDate(review.createdAt)
      +stars(review.rating)
    p.review__text= review.review
    if canEdit || canDelete
      .review__actions
        if canEdit
          button.link-btn(type='button' data-review-edit=review.id) Edit
        if canDelete
          button.link-btn.link-btn--danger(type='button' data-review-delete=review.id) Delete
    if canEdit
      form.review-edit.form(data-review-id=review.id hidden)
        +ratingInput(`rating-${review.id}`, review.rating)
        .field
          label.field__label(for=`review-text-${review.id}`) Your review
          textarea.field__input(id=`review-text-${review.id}` name='review' rows='3' required minlength='5')= review.review
        .form-actions
          button.btn.btn--small(type='submit') Save
          button.btn.btn--ghost.btn--small(type='button' data-review-cancel) Cancel
